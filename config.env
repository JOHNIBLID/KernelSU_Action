CONFIG_ENV=config.env

# ============================================================ Kernel source ==
# سورس شاومي 17 المخصص مع التاغ الدقيق لنواة 6.12.23
KERNEL_SOURCE=https://github.com/YuzakiKokuban/android_kernel_xiaomi_sm8850
KERNEL_SOURCE_BRANCH=Mi17_Kernel-ReSuki-susfs-20260916-1200
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=
ADD_LOCALVERSION_TO_FILENAME=false

# الأوامر المساعدة
EXTRA_CMDS=
CUSTOM_CMDS=

# =================================================================== Clang ==
CLANG_BRANCH=main-kernel
CLANG_VERSION=r596125
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
KSU_VARIANT=resukisu
KSU_REF=main
KSU_HOOK_MODE=kprobes
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# معطل ومحجوب تماماً لمنع التعارض مع درايفر الـ RT وتفادي البوتلوب
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true

# حقن التوقيع المصنعي لشاومي 17 لمطابقة نظام هاتفك بالملي
EXTRA_DEFCONFIG=CONFIG_LOCALVERSION_AUTO=n CONFIG_KSU_SUSFS=n
LOCALVERSION=-android16-5-g5a0e85dd9db0-ab14499855-4k

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
